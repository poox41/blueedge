PORT=7001
ADMIN_USERNAME=2026@bluedot
ADMIN_PASSWORD=2026@bluedot
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_ISSUER=blueedge
JWT_AUDIENCE=blueedge-api
BFF_BASE_URL=http://127.0.0.1:8080/api/v1
K8S_API_SERVER=https://127.0.0.1:16443
K8S_SKIP_TLS_VERIFY=true
K8S_TOKEN=
# K8S_AUTH_HEADER=Bearer <token>
# K8S_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Keep disabled until the BAMS URL and client secret are configured for the target environment.
BAMS_SSO_ENABLED=false
BAMS_SSO_BASE_URL=https://bams.example.com
ALLOW_INSECURE_TEST_HTTP=false
BAMS_SSO_EXCHANGE_PATH=/v1/sso/blueedge/exchange
BAMS_SSO_CLIENT_ID=blueedge
BAMS_SSO_CLIENT_SECRET=
# BAMS_SSO_CLIENT_SECRET_FILE=/run/secrets/bams-sso-client-secret
BAMS_SSO_REQUEST_TIMEOUT_MS=5000
BAMS_SSO_JWT_EXPIRES_IN=8h

# Empty means no cross-origin browser access; same-origin frontend proxy still works.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=20
SSO_RATE_LIMIT_MAX=20
